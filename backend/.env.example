DATABASE_URL=postgresql://...
SECRET_KEY=change-me-long-random-string      # REQUIRED in production
ENVIRONMENT=production                       # app refuses to start with the default SECRET_KEY
REQUIRE_APPROVAL=true
JOOBLE_API_KEY=...
CORS_ORIGINS=http://localhost:5173,https://job-board-frontend-opal.vercel.app
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
SITE_URL=https://job-board-frontend-opal.vercel.app
# optional: Telegram auto-share of newly published jobs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@yourchannel
TELEGRAM_SHARE_AGGREGATED=false
STALE_JOB_DAYS=30
# optional: GitHub token (no scopes needed) so Real Match can check many candidates per hour
GITHUB_TOKEN=
