# --- DATABASE ---
# Use postgresql:// for Neon/Supabase. Use sqlite:///./jobs.db for local SQLite.
DATABASE_URL=postgresql://...

# --- CORE SETTINGS ---
SECRET_KEY=change-me-long-random-string
ENVIRONMENT=production
REQUIRE_APPROVAL=true
JOOBLE_API_KEY=...
# OpenRouter key for the admin "AI parse" ingest. Get one at https://openrouter.ai/keys . Never commit the real value.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# --- URLS & CORS ---
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
# Address of the FRONTEND, used in emailed verify/reset links. NO trailing slash.
# Local: http://localhost:5173
# Production: https://your-vercel-app.vercel.app
SITE_URL=http://localhost:5173

# --- OAUTH ---
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# --- EMAIL (SMTP) ---
# Leave SMTP_HOST empty to only print emails to the console (good for local testing).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your full Gmail address, SMTP_PASSWORD=16-character App Password (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your16characterapppassword
SMTP_FROM_EMAIL=yourname@gmail.com
SMTP_FROM_NAME=JobBoard

# --- OPTIONAL / AUTOMATION ---
# Telegram auto-share of newly published jobs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@yourchannel
TELEGRAM_SHARE_AGGREGATED=false
STALE_JOB_DAYS=30
# GitHub token (no scopes needed) so Real Match can check many candidates per hour
GITHUB_TOKEN=