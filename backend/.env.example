DATABASE_URL=postgresql://...
SECRET_KEY=change-me-long-random-string      # REQUIRED in production
ENVIRONMENT=production                       # app refuses to start with the default SECRET_KEY
REQUIRE_APPROVAL=true
JOOBLE_API_KEY=...
CORS_ORIGINS=http://localhost:5173,https://job-board-frontend-opal.vercel.app
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# SITE_URL = address of the FRONTEND, used in the emailed verify / reset links. NO trailing slash.
#   local testing:  SITE_URL=http://localhost:5173
#   production (Render env var):  SITE_URL=https://job-board-frontend-opal.vercel.app
SITE_URL=https://job-board-frontend-opal.vercel.app
# optional: Telegram auto-share of newly published jobs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@yourchannel
TELEGRAM_SHARE_AGGREGATED=false
STALE_JOB_DAYS=30
# optional: GitHub token (no scopes needed) so Real Match can check many candidates per hour
GITHUB_TOKEN=
# email (verification, password reset, job alerts). Leave SMTP_HOST empty to only print emails to the log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your full Gmail address, SMTP_PASSWORD=16-character App Password (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your16characterapppassword
SMTP_FROM_EMAIL=yourname@gmail.com
SMTP_FROM_NAME=JobBoard
